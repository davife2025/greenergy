NODE_ENV=development
PORT=4000
API_CORS_ORIGIN=http://localhost:3000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long random string protecting cross-user system endpoints (e.g. carbon
# batch aggregation). Generate with: openssl rand -hex 32
ADMIN_JOB_SECRET=

# Paystack secret key (test key while developing) — used for payout transfers
# AND for collecting payments (Session 13) and verifying webhooks.
# IMPORTANT: once deployed, set this URL in the Paystack dashboard under
# Settings > API Keys & Webhooks: https://<your-api-domain>/webhooks/paystack
# — without that, real payments will never mark as paid, since nothing
# will tell us they succeeded.
PAYSTACK_SECRET_KEY=

# Optional — enables the AI review layer for carbon batch verification,
# using Kimi K2 via Hugging Face Inference Providers. Batches fall back
# to deterministic checks alone if unset. Get a token at
# huggingface.co/settings/tokens
HF_TOKEN=
HF_INFERENCE_MODEL=moonshotai/Kimi-K2-Instruct-0905

# Scheduler — set to "false" to disable and trigger aggregation/payouts
# manually via the /admin routes instead. Cron expression is UTC.
SCHEDULER_ENABLED=true
SCHEDULER_CRON=0 2 * * *
